    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst formatBlock = (label, value) => {\n  if (value === null || value === undefined || value === \"\") {\n    return `${label}: null`;\n  }\n\n  if (Array.isArray(value)) {\n    return `${label}:\\n${value.map(v => `  ${v}`).join(\"\\n\")}`;\n  }\n\n  return `${label}: ${value}`;\n};\n\nconst output =\n[\n  formatBlock(\"code\", item.code),\n  formatBlock(\"signal\", item.signal),\n  formatBlock(\"stderr\", item.stderr),  \n  formatBlock(\"stdout\", item.stdout),\n].join(\"\\n\\n\");\n\nreturn [\n  {\n    json: {\n      message: output\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
