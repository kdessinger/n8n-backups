        "value": "={{ $json.lastlogin }}",
        "dataPropertyName": "EVI_Last_login",
        "custom": true,
        "toFormat": "YYYY-MM-DD HH:mm:ss",
        "options": {
          "toTimezone": "Etc/GMT-4"
        }
      },
      "id": "7065235f-c512-4c9a-b718-f70c9d48427c",
      "name": "FixDate",
      "type": "n8n-nodes-base.dateTime",
      "typeVersion": 1,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH LastLoginRanked AS (\n    SELECT d.id AS districtID, d.name AS DistrictName, u.id as useridkey, u.userid, u.firstname, u.lastname, up.lastlogin,\n    ROW_NUMBER() OVER (PARTITION BY d.id ORDER BY up.lastlogin DESC) AS rn\n\tFROM evitesting.dbo.ecDistricts d\n\tJOIN evitesting.dbo.ecUsers u ON d.id = u.districtid\n\tLEFT JOIN (SELECT useridkey, MAX(lastlogin) AS lastlogin FROM evitesting.dbo.userproperties GROUP BY useridkey) up ON u.id = up.useridkey\n\tWHERE u.active = 1      -- Show active users only\n\tand u.adminaccount = 0  -- Hide admin logins\n)\nSELECT districtID, DistrictName, lastlogin\nFROM LastLoginRanked\nWHERE rn = 1 and lastlogin is not null\nOrder by districtID, userid;\n"
      },
      "name": "LastLogin Query",
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1,
      "position": [
        480,
        200
      ],
      "id": "77c1a9ea-c17d-46e6-a9c2-c2376d2fd7c8",
