    {
      "parameters": {
        "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n  <title>Please Wait — Generating Avatar</title>\n  <style>\n    :root{\n      --bg:#070A0F;\n      --panel:#0B1220;\n      --line:rgba(255,255,255,.10);\n      --text:#E7EEF9;\n      --muted:rgba(231,238,249,.72);\n      --glow:rgba(0,255,200,.35);\n      --accent:#00FFC8;\n      --danger:#FF3D71;\n    }\n    *{box-sizing:border-box}\n    html,body{height:100%}\n    body{\n      margin:0;\n      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, \"Apple Color Emoji\",\"Segoe UI Emoji\";\n      color:var(--text);\n      background:\n        radial-gradient(1200px 800px at 20% 10%, rgba(0,255,200,.10), transparent 55%),\n        radial-gradient(900px 600px at 80% 80%, rgba(255,61,113,.10), transparent 60%),\n        linear-gradient(180deg, #05070B, var(--bg));\n      overflow:hidden;\n    }\n\n    /* subtle \"scanline\" vibe */\n    body::before{\n      content:\"\";\n      position:fixed; inset:0;\n      background: repeating-linear-gradient(\n        to bottom,\n        rgba(255,255,255,.03) 0px,\n        rgba(255,255,255,.03) 1px,\n        transparent 2px,\n        transparent 6px\n      );\n      mix-blend-mode: overlay;\n      opacity:.18;\n      pointer-events:none;\n    }\n\n    .wrap{\n      min-height:100%;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      padding:24px;\n    }\n\n    .layout{\n      width:min(980px, 100%);\n      display:grid;\n      grid-template-columns: 320px 1fr;\n      gap:16px;\n      align-items:stretch;\n    }\n\n    @media (max-width: 860px){\n      .layout{grid-template-columns: 1fr}\n    }\n\n    .card{\n      border:1px solid var(--line);\n      background: linear-gradient(180deg, rgba(11,18,32,.92), rgba(7,10,15,.92));\n      border-radius:18px;\n      box-shadow:\n        0 20px 60px rgba(0,0,0,.55),\n        0 0 0 1px rgba(0,255,200,.06),\n        0 0 60px rgba(0,255,200,.10);\n      padding:22px 20px;\n      position:relative;\n      overflow:hidden;\n    }\n\n    .card::after{\n      content:\"\";\n      position:absolute; inset:-2px;\n      background: radial-gradient(600px 200px at 30% 0%, rgba(0,255,200,.18), transparent 60%);\n      pointer-events:none;\n      opacity:.9;\n    }\n\n    /* Left \"loadout\" panel */\n    .panelTitle{\n      position:relative;\n      z-index:1;\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n      gap:10px;\n      margin-bottom:14px;\n    }\n    .panelTitle h2{\n      margin:0;\n      font-size:14px;\n      letter-spacing:.6px;\n      text-transform:uppercase;\n      color:rgba(231,238,249,.86);\n    }\n    .tag{\n      font-size:11px;\n      padding:6px 10px;\n      border-radius:999px;\n      border:1px solid rgba(0,255,200,.20);\n      background: rgba(0,255,200,.08);\n      color:rgba(231,238,249,.9);\n      box-shadow: 0 0 18px rgba(0,255,200,.08);\n      white-space:nowrap;\n    }\n\n    .kv{\n      position:relative;\n      z-index:1;\n      display:grid;\n      gap:10px;\n    }\n    .row{\n      display:flex;\n      justify-content:space-between;\n      gap:12px;\n      padding:10px 12px;\n      border-radius:14px;\n      border:1px solid rgba(255,255,255,.08);\n      background: rgba(255,255,255,.03);\n    }\n    .k{\n      color:var(--muted);\n      font-size:12px;\n      line-height:1.2;\n      display:flex;\n      align-items:center;\n      gap:8px;\n      white-space:nowrap;\n    }\n    .k::before{\n      content:\"\";\n      width:6px;height:6px;border-radius:50%;\n      background: rgba(0,255,200,.55);\n      box-shadow: 0 0 14px rgba(0,255,200,.35);\n      flex:0 0 auto;\n    }\n    .v{\n      font-size:12.5px;\n      color:rgba(231,238,249,.92);\n      text-align:right;\n      max-width: 62%;\n      overflow:hidden;\n      text-overflow:ellipsis;\n      white-space:nowrap;\n    }\n    .mutedNote{\n      position:relative;\n      z-index:1;\n      margin-top:12px;\n      font-size:12px;\n      color:rgba(231,238,249,.62);\n      line-height:1.45;\n      border-top:1px dashed rgba(255,255,255,.12);\n      padding-top:12px;\n    }\n\n    /* Right main card */\n    .header{\n      position:relative;\n      display:flex;\n      gap:14px;\n      align-items:center;\n      z-index:1;\n    }\n\n    .badge{\n      width:46px; height:46px;\n      border-radius:14px;\n      border:1px solid rgba(0,255,200,.25);\n      background: rgba(0,255,200,.08);\n      display:grid;\n      place-items:center;\n      box-shadow: 0 0 0 4px rgba(0,255,200,.06);\n      flex:0 0 auto;\n    }\n    .badge svg{filter: drop-shadow(0 0 12px var(--glow));}\n\n    h1{\n      margin:0;\n      font-size:20px;\n      letter-spacing:.2px;\n      line-height:1.25;\n    }\n    .sub{\n      margin:6px 0 0;\n      color:var(--muted);\n      font-size:13.5px;\n      line-height:1.45;\n    }\n\n    .loader{\n      position:relative;\n      margin:18px 0 14px;\n      padding:16px 16px 14px;\n      border-radius:14px;\n      border:1px solid rgba(255,255,255,.08);\n      background: rgba(255,255,255,.03);\n      z-index:1;\n    }\n\n    .bar{\n      height:10px;\n      border-radius:999px;\n      overflow:hidden;\n      background: rgba(255,255,255,.08);\n      border:1px solid rgba(255,255,255,.10);\n    }\n    .bar > span{\n      display:block;\n      height:100%;\n      width:40%;\n      border-radius:999px;\n      background: linear-gradient(90deg, rgba(0,255,200,.15), rgba(0,255,200,.85), rgba(0,255,200,.25));\n      box-shadow: 0 0 18px rgba(0,255,200,.35);\n      animation: sweep 1.35s ease-in-out infinite;\n    }\n    @keyframes sweep{\n      0%{transform:translateX(-120%)}\n      50%{transform:translateX(120%)}\n      100%{transform:translateX(260%)}\n    }\n\n    .steps{\n      margin:10px 0 0;\n      display:flex;\n      flex-wrap:wrap;\n      gap:10px 14px;\n      color:var(--muted);\n      font-size:12.5px;\n      line-height:1.45;\n    }\n    .pill{\n      display:inline-flex;\n      align-items:center;\n      gap:8px;\n      padding:7px 10px;\n      border-radius:999px;\n      border:1px solid rgba(255,255,255,.10);\n      background: rgba(255,255,255,.02);\n    }\n    .dot{\n      width:8px;height:8px;border-radius:50%;\n      background: rgba(255,255,255,.20);\n      position:relative;\n      overflow:hidden;\n    }\n    .dot::after{\n      content:\"\";\n      position:absolute; inset:0;\n      background: var(--accent);\n      opacity:.9;\n      transform:scale(0);\n      animation: pulse 1.2s ease-in-out infinite;\n    }\n    .pill:nth-child(2) .dot::after{animation-delay:.2s}\n    .pill:nth-child(3) .dot::after{animation-delay:.4s}\n    @keyframes pulse{\n      0%,100%{transform:scale(0); opacity:.2}\n      50%{transform:scale(1); opacity:.9}\n    }\n\n    .tips{\n      margin:14px 0 0;\n      padding:14px 16px;\n      border-radius:14px;\n      border:1px dashed rgba(0,255,200,.22);\n      background: rgba(0,255,200,.06);\n      color:rgba(231,238,249,.86);\n      z-index:1;\n      position:relative;\n    }\n    .tips b{color:var(--text)}\n    .tips small{display:block; margin-top:6px; color:var(--muted)}\n\n    .footer{\n      margin-top:16px;\n      display:flex;\n      justify-content:space-between;\n      align-items:center;\n      gap:12px;\n      color:rgba(231,238,249,.62);\n      font-size:12px;\n      z-index:1;\n      position:relative;\n    }\n    .warn{\n      display:inline-flex;\n      align-items:center;\n      gap:8px;\n      padding:8px 10px;\n      border-radius:12px;\n      border:1px solid rgba(255,61,113,.22);\n      background: rgba(255,61,113,.06);\n      color:rgba(231,238,249,.80);\n    }\n    .spinner{\n      width:14px;height:14px;border-radius:50%;\n      border:2px solid rgba(0,255,200,.25);\n      border-top-color: rgba(0,255,200,.95);\n      animation: spin .8s linear infinite;\n    }\n    @keyframes spin{to{transform:rotate(360deg)}}\n  </style>\n</head>\n<body>\n  <div class=\"wrap\">\n    <div class=\"layout\">\n\n      <!-- LEFT: user selections -->\n      <aside class=\"card\" aria-label=\"Avatar settings\">\n        <div class=\"panelTitle\">\n          <h2>Loadout</h2>\n          <span class=\"tag\">LastZ Avatar Forge</span>\n        </div>\n\n        <div class=\"kv\">\n          <div class=\"row\">\n            <div class=\"k\">Alliance Code</div>\n            <div class=\"v\">{{ ($json['Alliance Code'] || 'ON1').replace(/[\\[\\]]/g, '') }}</div>\n          </div>\n\n          <div class=\"row\">\n            <div class=\"k\">Screen Name</div>\n            <div class=\"v\">{{ $json['Screen Name'] || '' }}</div>\n          </div>\n\n          <div class=\"row\">\n            <div class=\"k\">Gender</div>\n            <div class=\"v\">{{ ($json['Gender'] === 'None' ? '' : ($json['Gender'] || '')) }}</div>\n          </div>\n\n          <div class=\"row\">\n            <div class=\"k\">Color Style</div>\n            <div class=\"v\">{{ $json['Color Style'] || '' }}</div>\n          </div>\n        </div>\n\n        <div class=\"mutedNote\">\n          Tip: keep this tab open while we render your image and prep the download.\n        </div>\n      </aside>\n\n      <!-- RIGHT: please wait -->\n      <main class=\"card\" role=\"status\" aria-live=\"polite\">\n        <div class=\"header\">\n          <div class=\"badge\" aria-hidden=\"true\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\">\n              <path d=\"M12 2v3\" stroke=\"rgba(0,255,200,.95)\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n              <path d=\"M12 19v3\" stroke=\"rgba(0,255,200,.95)\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n              <path d=\"M4.22 4.22l2.12 2.12\" stroke=\"rgba(0,255,200,.75)\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n              <path d=\"M17.66 17.66l2.12 2.12\" stroke=\"rgba(0,255,200,.75)\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n              <path d=\"M2 12h3\" stroke=\"rgba(0,255,200,.75)\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n              <path d=\"M19 12h3\" stroke=\"rgba(0,255,200,.75)\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n              <path d=\"M4.22 19.78l2.12-2.12\" stroke=\"rgba(0,255,200,.55)\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n              <path d=\"M17.66 6.34l2.12-2.12\" stroke=\"rgba(0,255,200,.55)\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n              <circle cx=\"12\" cy=\"12\" r=\"4\" stroke=\"rgba(231,238,249,.85)\" stroke-width=\"2\"/>\n            </svg>\n          </div>\n          <div>\n            <h1>Generating your LastZ Avatar…</h1>\n            <p class=\"sub\">Please keep this tab open. We’re rendering your profile image and preparing a download link.</p>\n          </div>\n        </div>\n\n        <section class=\"loader\">\n          <div class=\"bar\" aria-hidden=\"true\"><span></span></div>\n          <div class=\"steps\" aria-hidden=\"true\">\n            <span class=\"pill\"><span class=\"dot\"></span> Packing your choices</span>\n            <span class=\"pill\"><span class=\"dot\"></span> Forging the image</span>\n            <span class=\"pill\"><span class=\"dot\"></span> Saving for download</span>\n          </div>\n        </section>\n\n        <section class=\"tips\">\n          <b>Heads up:</b> Avatar generation can take 10–30 seconds depending on load.\n          <small>If this page doesn’t advance after ~60 seconds, refresh once (your workflow should resume safely).</small>\n        </section>\n\n        <div class=\"footer\">\n          <span class=\"warn\"><span class=\"spinner\" aria-hidden=\"true\"></span> Please Wait</span>\n          <span>LastZ • Avatar Foundry</span>\n        </div>\n      </main>\n\n    </div>\n  </div>\n</body>\n</html>\n"
      },
