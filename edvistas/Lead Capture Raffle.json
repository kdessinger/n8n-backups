      "parameters": {
        "jsCode": "var optedInTags = [];\n\nfor (const item of $('Data').all()) {\n  if (item.json.optin_aims === \"1\") optedInTags.push(14);\n  if (item.json.optin_cd === \"1\") optedInTags.push(15);\n  if (item.json.optin_datamate === \"1\") optedInTags.push(10);\n  if (item.json.optin_drp === \"1\") optedInTags.push(7);\n  if (item.json.optin_dmp === \"1\") optedInTags.push(48);\n  if (item.json.optin_eduview === \"1\") optedInTags.push(5);\n  if (item.json.optin_eduform === \"1\") optedInTags.push(9);\n  if (item.json.optin_portfolioplus === \"1\") optedInTags.push(26);\n  if (item.json.optin_safeschools === \"1\") optedInTags.push(19);\n  if (item.json.optin_scoring === \"1\") optedInTags.push(16);\n  if (item.json.optin_stafftrac === \"1\") optedInTags.push(17);\n  if (item.json.optin_survate === \"1\") optedInTags.push(47);\n  if (item.json.optin_transsync === \"1\") optedInTags.push(33);\n  if (item.json.optin_mtss === \"1\") optedInTags.push(49);\n  item.json.tags = optedInTags;\n}\n\nreturn $('Data').all();"
      },
