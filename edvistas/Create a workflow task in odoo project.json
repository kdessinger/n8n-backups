    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"title\": \"🧠 Extract FAQ's from HelpDesk Tickets\",\n  \"workflow_id\": \"\",\n  \"department\": [\"IT\"],\n  \"project\": \"Corporate Workflows\",\n  \"tags\": [\"helpdesk\",\"IT\"],\n  \"assignees\": [\"Kenn Dessinger\"],\n  \"description_html\": \"<div style=\\\"font-size:14px; line-height:1.6;\\\"><p>Workflow ID: &lt;WORKFLOW_ID&gt;</p><hr><p>🚀 <strong>Extract FAQ's from HelpDesk Tickets</strong></p><p>Reviews closed/resolved helpdesk tickets to produce concise Q&amp;A entries for the knowledge base.</p><p><strong>Trigger</strong>: Ticket marked Resolved/Closed or scheduled batch scan.</p><p><strong>Steps</strong>:</p><ul><li>Shortlist candidate Q&amp;A pairs from tickets. 🧩</li><li>Normalize and dedupe; remove internal notes/PII. 🧼</li><li>Create draft KB articles in <strong>Odoo</strong> with source ticket ID. 📎</li><li>Notify editors for review and publish. ✉️</li></ul><p><strong>Outcome</strong>: Reviewed draft FAQs ready for approval, improving self-service and reducing repeat tickets.</p></div>\"\n}\n"
      },
