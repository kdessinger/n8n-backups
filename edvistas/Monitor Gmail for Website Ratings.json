          "attributes": [
            {
              "name": "reviewer_name",
              "description": "Name of the reviewer"
            },
            {
              "name": "reviewer_title",
              "description": "Title of the reviewer"
            },
            {
              "name": "reviewer_rating",
              "description": "Star rating (e.g., 5-star, 4-star)"
            },
            {
              "name": "reviewer_content",
              "description": "Review content (if provided, otherwise say \"Only rating given\")"
