      },
      "id": "35f99421-1244-44fd-bd11-6ffd238424f2",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [
        600,
        180
      ],
      "webhookId": "6f7b288e-1efe-4504-a6fd-660931327269",
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "## Simple API contact search in odoo\n\nIn this workflow we will accept a phone number and search odoo for the corresponding record and open to that client.\n\n",
        "height": 140.6222044621179,
        "width": 554.7042175838476
      },
      "id": "96cb81df-bbd0-4e8c-a29f-168a73669493",
      "name": "Note1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        601.3292513517301,
        0
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "### How to use it\n1. Execute the workflow so that the webhook starts listening\n2. Make a test request by pasting, **in a new browser tab**, the test URL from the `Webhook` node and appending the following test at the end `?q=8005551212`\n\nYou will receive a redirect from to the first name found in the contacts of production Odoo.\n\n",
        "height": 188.5538132729734,
        "width": 562.8363247771495
      },
      "id": "48affeee-a577-4113-bb42-21e12205c013",
      "name": "Note3",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        600,
        340
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "resource": "custom",
        "customResource": "res.partner",
        "operation": "getAll",
        "limit": 1,
        "options": {
          "fieldsList": [
            "name",
            "commercial_company_name",
            "mobile",
            "phone",
            "email",
            "phone_sanitized"
          ]
        },
        "filterRequest": {
          "filter": [
            {
              "fieldName": "phone_sanitized",
              "operator": "like",
              "value": "={{ $json[\"query\"][\"q\"] }}"
            }
          ]
        }
      },
      "id": "93165a83-4811-4121-8405-e5f44793eecf",
      "name": "Odoo Lookup",
      "type": "n8n-nodes-base.odoo",
      "typeVersion": 1,
      "position": [
        800,
        180
      ],
      "alwaysOutputData": true,
      "credentials": {
        "odooApi": {
          "id": "12",
          "name": "Odoo (Administrator)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<html>\n  <head>\n    <title>Incomming Call!</title>\n    <meta http-equiv=\"refresh\" content=\"0; URL={{ $json[\"url\"] }}\">\n  </head>\n  <body>\n    <h1>{{ $json[\"Name\"] }}</h1>\n    <h3>{{ $json[\"company\"] }}</h3>\n    <h3>{{ $json[\"email\"] }}</h3>\n    <h3>{{ $json[\"phone\"] }}</h3>\n    <h3>{{ $json[\"mobile\"] }}</h3>\n    You are being redirected to Odoo.\n  </body>\n</html>\n",
        "options": {}
      },
      "id": "8d9a7767-d13a-4632-b9ab-689c89f38aaa",
