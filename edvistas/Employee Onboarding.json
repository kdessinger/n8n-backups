    {
      "parameters": {
        "operation": "sendAndWait",
        "fromEmail": "admin@edvistas.com",
        "toEmail": "kdessinger@edvistas.com",
        "subject": "Approval Required",
        "message": "=<table style=\"width: 100%; font-family: Arial, sans-serif; background-color: #f9f9f9; padding: 20px;\">\n  <tr>\n    <td align=\"center\">\n      <table style=\"max-width: 600px; background-color: #ffffff; border-radius: 8px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);\">\n        <tr>\n          <td style=\"text-align: center; font-size: 20px; font-weight: bold; color: #333;\">\n            🚨 Approval Required\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding: 20px 0 10px; font-size: 16px; color: #444; text-align: center;\">\n            A new employee has been detected in <strong>Odoo</strong>.<br>\n            Would you like to add this user to <strong>Active Directory</strong>?\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding: 20px 0; font-size: 14px; color: #333;\">\n            <table align=\"center\" cellpadding=\"4\" cellspacing=\"0\" style=\"border-collapse: collapse; margin: 0 auto;\">\n              <tr>\n                <td style=\"text-align: right; font-weight: bold; padding-right: 10px;\">Name:</td>\n                <td style=\"text-align: left;\">{{ $json.name }}</td>\n              </tr>\n              <tr>\n                <td style=\"text-align: right; font-weight: bold; padding-right: 10px;\">Email:</td>\n                <td style=\"text-align: left;\"><a href=\"mailto:{{ $json.work_email }}\" style=\"color: #0066cc;\">{{ $json.work_email }}</a></td>\n              </tr>\n              <tr>\n                <td style=\"text-align: right; font-weight: bold; padding-right: 10px;\">Title:</td>\n                <td style=\"text-align: left;\">{{ $json.job_title }}</td>\n              </tr>\n              <tr>\n                <td style=\"text-align: right; font-weight: bold; padding-right: 10px;\">Department:</td>\n                <td style=\"text-align: left;\">{{ $json.department }}</td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"font-size: 12px; color: #888; text-align: center;\">\n            Automated with <a href=\"https://n8n.io\" style=\"color: #888; text-decoration: none;\">n8n</a>\n          </td>\n        </tr>\n      </table>\n\n      <p style=\"font-size: 11px; color: #666; max-width: 600px; margin-top: 20px; line-height: 1.4; text-align: center;\">\n        <strong>Confidentiality Notice:</strong> The information contained in this email and any attachments may be confidential. \n        If you are not an intended recipient, you are hereby notified that any dissemination, distribution, or copying of this email is strictly prohibited. \n        If you received this email in error, please notify the sender and permanently delete the email and any attachments. Thank you.\n      </p>\n    </td>\n  </tr>\n</table>\n",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {}
      },
