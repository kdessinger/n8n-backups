    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DECLARE @NoDist table (ID SmallInt) Insert into @NoDist values (-1), (21), (804), (805), (806), (815)\nDECLARE @tdate datetime set @tdate = GetDate()\n\nSelect * from (\nSelect 'AIMS' as Name, Count(*) as Count, @tdate Date FROM aims..districts a Where a.enabled=1 and a.id not in(Select ID from @NoDist)\nunion select 'Courses' Name, Count(*) Count, @tdate Date FROM rbemcd..courses r Where r.districtid >0 and r.districtid not in(Select ID from @NoDist)\nunion select 'Datamate Elite' Name, Count(*) Count, @tdate Date from evitesting..districts e WHERE e.enabled=1 and e.id not in(Select ID from @NoDist) and e.datamateElite = 1\nunion select 'Datamate Live' Name, Count(*) Count, @tdate Date FROM evitesting..districts e WHERE e.enabled=1 and e.id not in(Select ID from @NoDist) and e.dmversion = 'Live'\nunion select 'Datamate Basic' Name, Count(*) Count, @tdate Date FROM evitesting..districts e WHERE e.enabled=1 and e.id not in(Select ID from @NoDist) and e.dmversion = 'Basic'\nunion select 'Districts' as Name, Count(*) Count, @tdate Date from eviForms..ecDistricts d Where d.id not in(Select ID from @NoDist)\nunion select 'Forms' as Name, Count(*) Count, @tdate Date  from eviForms..forms Where complete=0\nunion select 'Guardians' as Name, Count(*) Count, @tdate Date from eviForms..ecGuardians\nunion select 'SafeSchools' as Name, Count(*) Count, @tdate Date from safeschools..district ss Where ss.enabled=1 and (ss.trial = 0 or ss.trial is null) and ss.id not in(Select ID from @NoDist)\nunion select 'Schools' as Name, Count(*) Count, @tdate Date  from eviForms..ecschools \nunion select 'SMS' as Name, Sum(segments) Count, @tdate Date From eviForms..smsLog \nunion select 'Staff' as Name, Count(*) Count, @tdate Date  from eviForms..ecStaff sf where disabled=0 and sf.districtId not in (Select ID from @NoDist)\nunion select 'StaffTrac' as Name, Count(*) Count, @tdate Date FROM stafftrac..districts st Where st.enabled=1 and st.id not in (Select ID from @NoDist)\nunion select 'Students' as Name, Count(*) Count, @tdate Date  from eviForms..ecStudents s where active=1 and s.districtid not in (Select ID from @NoDist)\nunion select 'Surveys' as Name, Count(*) Count, @tdate Date FROM eviSurvate..surveys sv Where sv.disable=0 and sv.districtid not in (Select ID from @NoDist)\nunion select 'Users' as Name, Count(*) Count, @tdate Date  from eviForms..ecUsers u where u.active=1 and u.districtid not in (Select ID from @NoDist)\nunion select 'Item Bank' as Name, Count(*) Count, @tdate Date FROM evitesting..questionBank q\n ) l\n Pivot (\n\tSum(l.count) For l.name\n\tIn ([AIMS],[Courses],[Datamate Elite],[Datamate Live],[Datamate Basic],[Districts],[Forms],[Guardians],[SafeSchools],[Schools],[SMS],[Staff],[StaffTrac],[Students],[Surveys],[Users],[Item Bank])\n ) as pivotTable"
      },
