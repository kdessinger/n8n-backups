    {
      "parameters": {
        "jsCode": "const start = new Date(items[0].json.start);\nconst end = new Date(items[0].json.end);\nconst durationInHours = Math.floor((end - start) / 60000 / 60);\nconsole.log(`Meeting duration: ${durationInHours} minutes`);\n\nreturn { json: { \n  //id: items[0].json.id, \n  //meetingNumber: items[0].json.meetingNumber, \n  title: items[0].json.title,  \n  agenda: items[0].json.agenda,  \n  password: items[0].json.password,\n  \n  MeetingStart: start.toString(),\n  MeetingEnd: end.toDateString(),\n  \n  duration: durationInHours,\n  hostDisplayName: items[0].json.hostDisplayName,  \n  hostEmail: items[0].json.hostEmail,  \n  webLink: items[0].json.webLink,  \n  callInNumber: items[0].json.telephony.callInNumbers[0].callInNumber  \n}};\n\n\n"
      },
