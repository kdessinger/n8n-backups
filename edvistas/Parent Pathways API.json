      "parameters": {
        "mode": "raw",
        "jsonOutput": "={\n  \"id\": {{ $json.order_id[0] }},\n  \"order_id\": \"{{ $json.order_id[1] }}\",\n  \"order_date\": \"{{ $json.date_order }}\",\n  \"end_date\": \"{{ (() => { \n    const orderDate = new Date($json.date_order);\n    orderDate.setFullYear(orderDate.getFullYear() + 1);\n    const year = orderDate.getFullYear();\n    const month = (orderDate.getMonth() + 1).toString().padStart(2, '0'); \n    const day = orderDate.getDate().toString().padStart(2, '0'); \n    const hours = orderDate.getHours().toString().padStart(2, '0'); \n    const minutes = orderDate.getMinutes().toString().padStart(2, '0'); \n    const seconds = orderDate.getSeconds().toString().padStart(2, '0'); \n    return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`; \n  })() }}\",\n  \"order_qty\": {{ $json.product_uom_qty }},\n  \"access_token\": \"{{ $json.access_token }}\",\n  \"payment_processed\": \"{{ $('Payment Transaction').item.json.is_post_processed }}\",\n  \"payment_status\": \"{{ $('Payment').item.json.state }}\",\n  \"Company\": \"{{ $json.company_name === 'false' || $json.company_name === null || !$json.company_name ? '' : $json.company_name }}\",\n  \"full_name\": \"{{ $json.name }}\",  \n  \"first_name\": \"{{ $json.name.split(' ')[0] }}\",\n  \"last_name\": \"{{ $json.name.split(' ').slice(1).join(' ') }}\",\n  \"email\": \"{{ $json.email }}\",\n  \"phone\": \"{{ $json.phone }}\",\n  \"phone_sanitized\": \"{{ $json.phone_sanitized === 'false' || $json.phone_sanitized === null || !$json.phone_sanitized ? '' : $json.phone_sanitized }}\",\n  \"street\": \"{{ $json.street }}\",\n  \"street2\": \"{{ $json.street2 === 'false' || $json.street2 === null || !$json.street2 ? '' : $json.street2 }}\",\n  \"city\": \"{{ $json.city }}\",\n  \"state\": \"{{ $json.code }}\",\n  \"zip\": \"{{ $json.zip }}\",\n  \"country\": \"{{ $json.country_id[1] }}\"\n}\n",
