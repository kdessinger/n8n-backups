    {
      "parameters": {
        "jsCode": "const tagid = $('Queries').item.json.tagId;\n\nfor (const item of $input.all()) {\n  const category_id = item.json.category_id;\n  \n  if (!category_id.includes(tagid)) {\n    category_id.push(tagid);\n  }\n}\n\nconsole.log(tagid); // Output the value of tagid to the console\nreturn $input.all();"
      },
      "id": "854fe4d1-2992-45a2-b972-6ed719034e3d",
      "name": "Insert Tags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        -320
      ],
      "disabled": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const tagid = $('Queries').item.json.tagId;\n\nfor (const item of $input) {\n  const category_id = item.json.category_id;\n  \n  if (category_id.includes(tagid)) {\n    const index = category_id.indexOf(tagid);\n    category_id.splice(index, 1);\n  }\n}\n\nconsole.log(tagid); // Output the value of tagid to the console\nreturn $input;\n"
      },
