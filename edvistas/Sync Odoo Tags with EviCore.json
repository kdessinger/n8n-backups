    {
      "parameters": {
        "jsCode": "// Access the category_id array\nconst category_id = items[0].json.category_id;\nconsole.log(category_id);\n\n// Define the variable from $node\nconst tagId = $node[\"Queries\"].json[\"tagId\"];\nconsole.log(tagId);\n\n// Check if the value (tagId) is not in the array\nif (category_id.includes(tagId)) {\n  const index = category.indexOf(tagid);\n  category_id.splice(index, 1);\n}\n\n// Return the modified item\nreturn items;\n"
      },
      "id": "001a8353-b18b-408e-a10d-390b6535e696",
      "name": "Remove Tags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        -160
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH DistrictProducts AS (\n    SELECT\n\t\tid,\n        district,\n        ('3, ' + STRING_AGG(CONVERT(NVARCHAR(20), tagId), ', ')) AS Products\n    FROM (\n        SELECT\n\t\t\tid,\n            district,\n            Product,\n            tagId\n        FROM (            \n\t\t\t\t/* Aims Districts */\n\t\t\t\tSELECT d.id as id, d.name as district, 'Aims' as Product, 71 as tagId\n\t\t\t\tFROM evicore..districts d\n\t\t\t\tleft join aims..districts a on d.id = a.id\n\t\t\t\tWhere enabled=1 --and aimsyear >= YEAR(GETDATE())\n\t\t\t\tUNION\n\t\t\t\t/* Bars Districts */\n\t\t\t\tSELECT d.id as id, d.name as district, 'Bars' as Product, 75 as tagId\n\t\t\t\tFROM evicore..districts d \n\t\t\t\tjoin evitesting..districts t on d.id = t.id\n\t\t\t\tWhere t.enabled=1 and t.barsDistrict=1 \n\t\t\t\tUNION\n\t\t\t\t/* Curriculum Developer Districts */\n\t\t\t\tSELECT d.id as id, d.name as district, 'CD' as Product, 74 as tagId\n\t\t\t\tFROM evicore..districts d\n\t\t\t\tleft join rbemcd..districts r on d.id = r.districtid\n\t\t\t\tWhere  r.enabled=1 \n\t\t\t\tUNION\n\t\t\t\t/* Datamate Basic Districts */\n\t\t\t\tSELECT d.id as id, d.name as district, 'DataMate' as Product, 47 as tagId\n\t\t\t\tFROM evicore..districts d \n\t\t\t\tjoin evitesting..districts t on d.id = t.id\n\t\t\t\tWhere t.enabled=1 and t.dmversion='Basic'\n\t\t\t\tUNION\n\t\t\t\t/* Datamate Live Districts */\n\t\t\t\tSELECT d.id as id, d.name as district, 'DataMate:Live' as Product, 77 as tagId\n\t\t\t\tFROM evicore..districts d \n\t\t\t\tjoin evitesting..districts t on d.id = t.id\n\t\t\t\tWhere t.enabled=1 and t.dmversion='Live'\n\t\t\t\tUNION\n\t\t\t\t/* DRP Districts */\n\t\t\t\tSELECT d.id as id, d.name as district, 'DRP' as Product, 46 as tagId\n\t\t\t\tFROM evicore..districts d\n\t\t\t\tjoin evitesting..districts e on d.id = e.id\n\t\t\t\tWhere e.drpDistrict = 1\n\t\t\t\tUNION\n\t\t\t\t/* EduForm Districts */\n\t\t\t\tSELECT d.id as id, d.name as district, 'EduForm' as Product, 69 as tagId\n\t\t\t\tFROM evicore..districts d\n\t\t\t\tleft join eviForms..districts f on d.id = f.id\n\t\t\t\tWhere f.enabled=1 \n\t\t\t\tUNION\n\t\t\t\t/* EduView Districts */\n\t\t\t\tSELECT d.id as id, d.name as district, 'DataMate' as Product, 47 as tagId\n\t\t\t\tFROM evicore..districts d\n\t\t\t\tleft join eduviewEvi..rptDistricts ev on d.id = ev.id\n\t\t\t\tWhere ev.disabled=0\n\t\t\t\tUNION\n\t\t\t\t/* Datamate Elite Districts */\n\t\t\t\tSELECT d.id as id, d.name as district, 'Elite' as Product, 76 as tagId\n\t\t\t\tFROM evicore..districts d \n\t\t\t\tjoin evitesting..districts t on d.id = t.id\n\t\t\t\tWhere t.enabled=1 and t.datamateElite=1\n\t\t\t\tUNION\n\t\t\t\t/* SafeSchools Districts */\n\t\t\t\tSELECT d.id as id, d.name as district, 'SafeSchool' as Product, 73 as tagId\n\t\t\t\tFROM evicore..districts d\n\t\t\t\tleft join safeschools..district ss on d.id = ss.id\n\t\t\t\tWhere ss.enabled=1 \n\t\t\t\tUNION\n\t\t\t\t/* Scoring Districts */\n\t\t\t\tSELECT d.id as id, d.name as district, 'Scoring' as Product, 16 as tagId\n\t\t\t\tFROM evicore..districts d \n\t\t\t\tjoin evitesting..districts t on d.id = t.id\n\t\t\t\tWhere t.nyScoringDistrict = 1 and enabled = 1\n\t\t\t\tUNION\n\t\t\t\t/* StaffTrac Districts */\n\t\t\t\tSELECT d.id as id, d.name as district, 'StaffTrac' as Product, 70 as tagId\n\t\t\t\tFROM evicore..districts d\n\t\t\t\tleft join stafftrac..districts s on d.id = s.id\n\t\t\t\tWhere s.id is not null and s.enabled=1\n\t\t\t\tUNION\n\t\t\t\t/* Survate */\n\t\t\t\tSELECT d.id as id, d.name as district, 'Survate' as Product, 81 as tagId\n\t\t\t\tFROM evicore..districts d\n\t\t\t\tleft join eviSurvate..districts sv on d.id = sv.id\n\t\t\t\tWhere enabled=1\n\t\t\t\tUNION\n\t\t\t\t/* TransSync Districts */\n\t\t\t\tSelect id, name as district, 'TransSync' as Product, 82 as tagId\n\t\t\t\tFROM evicore..districts\n\t\t\t\tWhere enableTransSync=1\n\n        ) AS SourceData\n        GROUP BY id, district, Product, tagId\n    ) AS PivotData\n    GROUP BY id, district\n)\nSELECT\n\tid,\n    district,\n    Products\nFROM DistrictProducts\nORDER BY district;\n"
      },
