  "name": "Sync Odoo Tags with EviCore",
  "nodes": [
    {
      "parameters": {
        "content": "## Sync Odoo Tags with District Software\nThe Workflow will set the scoring tags on all EVI districts that are designated as a scoring district. \nThis is a Sync operation so it will remove add and remove tags from odoo to match EVICore.\n",
        "height": 554.1972408930528,
        "width": 1317.6636615332295
      },
      "id": "80fcbb37-8bcc-42e1-b79f-1c7690d632af",
      "name": "Sticky Note3",
