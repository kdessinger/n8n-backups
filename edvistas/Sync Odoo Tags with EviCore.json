    {
      "parameters": {
        "operation": "executeQuery",
        "query": "/* Bars Districts */\nSELECT d.id, d.name\nFROM evicore..districts d \njoin evitesting..districts t on d.id = t.id\nWhere t.enabled=1 and t.barsDistrict=1 "
