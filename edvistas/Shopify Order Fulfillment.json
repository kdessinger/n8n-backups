      {
        "parameters": {
          "operation": "executeQuery",
          "query": "MERGE dbo.Shopify AS tgt\nUSING (SELECT\n  {{ $json.OrderId }} AS OrderId\n) AS src\nON tgt.OrderId = src.OrderId\nWHEN MATCHED THEN\n  UPDATE SET\n    OrderName       = '{{ ($json.OrderName || \"\").replace(/'/g,\"''\") }}',\n    CustomerEmail   = '{{ ($json.CustomerEmail || \"\").replace(/'/g,\"''\") }}',\n    FinancialStatus = '{{ ($json.FinancialStatus || \"\").replace(/'/g,\"''\") }}',\n    Currency        = '{{ ($json.Currency || \"\").replace(/'/g,\"''\") }}',\n    TotalPrice      = {{ $json.TotalPrice ?? 'NULL' }},\n    CreatedAt       = TRY_CONVERT(datetime2(0), '{{ ($json.CreatedAt || \"\").replace(/'/g,\"''\") }}'),\n    UpdatedAt       = TRY_CONVERT(datetime2(0), '{{ ($json.UpdatedAt || \"\").replace(/'/g,\"''\") }}'),\n    RawBodyJson     = '{{ ($json.RawBodyJson || \"\").replace(/'/g,\"''\") }}'\nWHEN NOT MATCHED THEN\n  INSERT (OrderId, OrderName, CustomerEmail, FinancialStatus, Currency, TotalPrice, CreatedAt, UpdatedAt, RawBodyJson)\n  VALUES (\n    {{ $json.OrderId }},\n    '{{ ($json.OrderName || \"\").replace(/'/g,\"''\") }}',\n    '{{ ($json.CustomerEmail || \"\").replace(/'/g,\"''\") }}',\n    '{{ ($json.FinancialStatus || \"\").replace(/'/g,\"''\") }}',\n    '{{ ($json.Currency || \"\").replace(/'/g,\"''\") }}',\n    {{ $json.TotalPrice ?? 'NULL' }},\n    TRY_CONVERT(datetime2(0), '{{ ($json.CreatedAt || \"\").replace(/'/g,\"''\") }}'),\n    TRY_CONVERT(datetime2(0), '{{ ($json.UpdatedAt || \"\").replace(/'/g,\"''\") }}'),\n    '{{ ($json.RawBodyJson || \"\").replace(/'/g,\"''\") }}'\n  );\n"
        },
