      {
        "parameters": {
          "operation": "executeQuery",
          "query": ";WITH src AS (\n  SELECT\n    TRY_CONVERT(bigint, {{ $json.OrderId }})    AS OrderId,\n    TRY_CONVERT(bigint, {{ $json.LineItemId }}) AS LineItemId,\n\n    TRY_CONVERT(bigint, {{ $json.ProductId }})  AS ProductId,\n    TRY_CONVERT(bigint, {{ $json.VariantId }})  AS VariantId,\n\n    '{{ ($json.Title || '').replace(/'/g, \"''\") }}' AS Title,\n    '{{ ($json.Sku   || '').replace(/'/g, \"''\") }}' AS Sku,\n\n    COALESCE(TRY_CONVERT(int, {{ $json.Quantity }}), 0) AS Quantity,\n    TRY_CONVERT(decimal(18,2), {{ $json.Price }}) AS Price,\n    TRY_CONVERT(int, {{ $json.Grams }})          AS Grams,\n\n    COALESCE(TRY_CONVERT(bit, {{ $json.RequiresShipping }}), 0) AS RequiresShipping,\n    COALESCE(TRY_CONVERT(bit, {{ $json.Taxable }}), 0)          AS Taxable,\n\n    '{{ ($json.FulfillmentService || '').replace(/'/g, \"''\") }}' AS FulfillmentService,\n    CASE\n      WHEN {{ $json.FulfillmentStatus }} IS NULL THEN NULL\n      ELSE '{{ ($json.FulfillmentStatus || '').replace(/'/g, \"''\") }}'\n    END AS FulfillmentStatus,\n\n    '{{ ($json.RawLineItemJson || '').replace(/'/g, \"''\") }}' AS RawLineItemJson\n)\n, src2 AS (\n  SELECT *\n  FROM src\n  WHERE OrderId IS NOT NULL\n    AND LineItemId IS NOT NULL\n)\nMERGE dbo.Shopify_LineItems AS tgt\nUSING src2\nON tgt.OrderId = src2.OrderId\nAND tgt.LineItemId = src2.LineItemId\n\nWHEN MATCHED THEN\n  UPDATE SET\n    ProductId = src2.ProductId,\n    VariantId = src2.VariantId,\n    Title = src2.Title,\n    Sku = src2.Sku,\n    Quantity = src2.Quantity,\n    Price = src2.Price,\n    Grams = src2.Grams,\n    RequiresShipping = src2.RequiresShipping,\n    Taxable = src2.Taxable,\n    FulfillmentService = src2.FulfillmentService,\n    FulfillmentStatus = src2.FulfillmentStatus,\n    RawLineItemJson = src2.RawLineItemJson\n\nWHEN NOT MATCHED THEN\n  INSERT (\n    OrderId, LineItemId, ProductId, VariantId,\n    Title, Sku, Quantity, Price, Grams,\n    RequiresShipping, Taxable,\n    FulfillmentService, FulfillmentStatus, RawLineItemJson\n  )\n  VALUES (\n    src2.OrderId, src2.LineItemId, src2.ProductId, src2.VariantId,\n    src2.Title, src2.Sku, src2.Quantity, src2.Price, src2.Grams,\n    src2.RequiresShipping, src2.Taxable,\n    src2.FulfillmentService, src2.FulfillmentStatus, src2.RawLineItemJson\n  );\n"
        },
