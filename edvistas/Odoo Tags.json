    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.id, d.name\nFROM evicore..districts d join evitesting..districts et on d.id = et.id\nWhere et.nyScoringDistrict = 1 or et.nyScoringDistrict is null\n"
      },
      "name": "Scoring Districts",
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1,
      "position": [
        620,
        1640
      ],
      "id": "ff0710dd-c993-4f66-9399-d53e2e57a078",
      "credentials": {
        "microsoftSql": {
          "id": "8",
          "name": "DB1.DS1.GOWLS.COM (kdessinger)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  const category_id = item.json.category_id;\n  \n  if (category_id.includes(16)) {\n    const index = category_id.indexOf(16);\n    category_id.splice(index, 1);\n  }\n}\n\nreturn $input.all();\n\n"
      },
      "id": "84c58029-f9f6-4faa-a87e-e1a0bcdbe9df",
      "name": "Delete Scoring Tags",
      "type": "n8n-nodes-base.code",
