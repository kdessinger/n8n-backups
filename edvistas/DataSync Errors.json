        "query": "SELECT        d.id AS districtID, d.name AS DistrictName, u.adminaccount, u.active, d.techcontact, d.techphone, d.techemail, d.sistype, u.userid, u.firstname, u.lastname\nFROM            evitesting.dbo.ecDistricts AS d LEFT OUTER JOIN\n                         evitesting.dbo.ecUsers AS u ON d.id = u.districtid\nWHERE        (u.userid = '{{ $json.Login }}')"
