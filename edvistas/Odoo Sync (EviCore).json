    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH LastLoginRanked AS (\n    SELECT d.id AS districtID, d.name AS DistrictName, u.id as useridkey, u.userid, u.firstname, u.lastname, up.lastlogin,\n    ROW_NUMBER() OVER (PARTITION BY d.id ORDER BY up.lastlogin DESC) AS rn\n\tFROM evitesting.dbo.ecDistricts d\n\tLEFT JOIN evitesting.dbo.ecUsers u ON d.id = u.districtid\n\tLEFT JOIN (SELECT useridkey, MAX(lastlogin) AS lastlogin FROM evitesting.dbo.userproperties GROUP BY useridkey) up ON u.id = up.useridkey\n)\nSELECT llr.districtID, DistrictName, lastlogin, d.lastDataSync as LastSync, sistype, statecode\nFROM LastLoginRanked llr\njoin evicore..districts d on llr.districtID = d.id\nWHERE rn = 1\nOrder by DistrictName;\n"
      },
      "id": "56a2281f-703a-4b72-ada6-5d513e189523",
      "name": "Evicore (DB1)",
      "type": "n8n-nodes-base.microsoftSql",
