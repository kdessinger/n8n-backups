    {
      "parameters": {
        "content": "## Simple API contact search for odoo\n\nIn this workflow we will accept a phone number and search odoo for the corresponding record and open to that client.\n\n",
        "height": 299.75896759585885,
        "width": 850.112094787866
      },
      "id": "3b9ec913-0bbe-4906-bf8e-da352b556655",
      "name": "Note1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        560,
        -20
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "Name",
              "value": "={{ $json[\"name\"] }}"
            },
            {
              "name": "email",
              "value": "={{ $json[\"email\"] }}"
            },
            {
              "name": "company",
              "value": "={{ $json[\"commercial_company_name\"] }}"
            },
            {
              "name": "mobile",
              "value": "={{ $json[\"mobile\"] }}"
            },
            {
              "name": "phone",
              "value": "={{ $json[\"phone\"] }}"
            },
            {
              "name": "url",
              "value": "=https://odoo-stage.edvistas.com/web#id={{ $json[\"id\"] }}&menu_id=111&action=139&model=res.partner&view_type=form"
            }
          ]
        },
        "options": {}
      },
      "id": "5a228fcb-78b9-4a28-95d2-d7c9fdf1d4ea",
      "name": "Create URL string",
      "type": "n8n-nodes-base.set",
      "position": [
        980,
        120
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "### How to use it\n1. Execute the workflow so that the webhook starts listening\n2. Make a test request by pasting, **in a new browser tab**, the test URL from the `Webhook` node and appending the following test at the end `?q=8005551212`\n\nYou will receive the following output in the new tab `The URL of the Odoo search query for the term \"bob dylan\" is:\n\n",
        "height": 220,
        "width": 600
      },
      "id": "e7971820-45a8-4dc8-ba4c-b3220d65307a",
      "name": "Note3",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        680,
        300
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<html>\n  <head>\n    <title>Incomming Call!</title>\n    <meta http-equiv=\"refresh\" content=\"0; URL={{ $json[\"url\"] }}\">\n  </head>\n  <body>\n    <h1>{{ $json[\"Name\"] }}</h1>\n    <h1>{{ $json[\"company\"] }}</h2>\n    <h1>{{ $json[\"email\"] }}</h3>\n    <h1>{{ $json[\"phone\"] }}</h3>\n    <h1>{{ $json[\"mobile\"] }}</h3>\n    You are being redirected to Odoo.\n  </body>\n</html>\n",
        "options": {}
      },
      "id": "f45271e6-6183-4e43-8c18-2d276fb9193d",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1180,
        120
      ]
    },
    {
      "parameters": {
        "resource": "custom",
        "customResource": "res.partner",
        "operation": "getAll",
        "limit": 2,
        "options": {
          "fieldsList": [
            "name",
            "commercial_company_name",
            "mobile",
            "phone",
            "email",
            "phone_sanitized"
          ]
        },
        "filterRequest": {
          "filter": [
            {
              "fieldName": "phone_sanitized",
              "operator": "like",
              "value": "={{ $json[\"query\"][\"q\"] }}"
            }
          ]
        }
      },
