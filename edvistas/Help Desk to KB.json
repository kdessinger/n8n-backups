    {
      "parameters": {
        "promptType": "define",
        "text": "=Source: {{ $json.record_name }}\nSubject: {{ $json.subject }}\nBody: {{ $json.body.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").trim() }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an FAQ generation assistant. Your task is to analyze helpdesk tickets from Odoo18-EE. Your job is to analyze the data presented to you from the database and then you will determine if the ticket has a Question/Answer pair that can be added to our knowledgebase.\n\nIf you find a clear question-and-answer pair, extract them as follows:\n\nId: (Ticket's database id)\nSource: (Ticket number)\nQuestion: (summarize the customer’s question)\nAnswer: (summarize the support agent’s answer)\n\nIf no valid Q&A pair is found, output only: false\n\nInstructions:\n\nOnly extract information that is clearly a question from the customer and an answer from the agent.\n\nRedact or omit any sensitive or personally identifiable information.\n\nFormat each result exactly as specified above."
        }
      },
