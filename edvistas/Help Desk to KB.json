    {
      "parameters": {
        "mode": "combineBySql",
        "numberInputs": 3,
        "query": "SELECT\n  i1.id                 AS ticket_id,\n  i1.name               AS ticket_name,\n  i1.state,\n  i1.`stage_id[0]`      AS stage_id,\n  i1.`stage_id[1]`      AS stage_name,\n  i1.`priority[0]`      AS priority_value,\n  i1.`priority[1]`      AS priority_label,\n  i1.`partner_id[0]`    AS partner_id,\n  i1.`partner_id[1]`    AS partner_name,\n  i1.`ticket_type[0]`   AS ticket_type_id,\n  i1.`ticket_type[1]`   AS ticket_type_label,\n  i1.`subject_id[0]`    AS subject_id,\n  i1.`subject_id[1]`    AS subject_name,\n  i1.tag_ids,\n  i1.description        AS ticket_description,\n\n  i2.id                 AS message_id,\n  i2.res_id             AS message_res_id,\n  i2.subject            AS message_subject,\n  i2.email_from         AS message_from,\n  i2.body               AS message_body,\n  i2.message_type,\n  i2.parent_id,\n  i2.record_name,\n  i2.`author_id[0]`     AS message_author_id,\n  i2.`author_id[1]`     AS message_author_name,\n  i2.`subtype_id[0]`    AS message_subtype_id,\n  i2.`subtype_id[1]`    AS message_subtype_name\n\nFROM input1 AS i1\nLEFT JOIN input2 AS i2\n  ON CAST(i2.res_id AS INTEGER) = CAST(i1.id AS INTEGER)\nORDER BY i1.id, i2.id;\n",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        288,
        1040
      ],
      "id": "06377d4e-371c-424a-8b75-8bd8b1d55f50",
      "name": "Merge"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  t.id,\n  t.name,\n  array_remove(array_agg(DISTINCT tg.name), NULL) AS tags,\n  jsonb_agg(\n    jsonb_build_object(\n      'date', m.date,\n      'author_id', m.author_id,\n      'type', m.message_type,\n      'body', m.body\n    ) ORDER BY m.date\n  ) AS messages\nFROM helpdesk_ticket t\nLEFT JOIN helpdesk_tags_helpdesk_ticket_rel rel\n  ON rel.helpdesk_ticket_id = t.id\nLEFT JOIN helpdesk_tags tg\n  ON tg.id = rel.helpdesk_tags_id\nLEFT JOIN mail_message m\n  ON m.model = 'helpdesk.ticket'\n  AND m.res_id = t.id\n  AND m.message_type IN ('comment', 'email')\nWHERE t.write_date > now() - interval '7 days'\nGROUP BY t.id;\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
