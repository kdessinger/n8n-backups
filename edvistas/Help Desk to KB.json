    {
      "parameters": {
        "mode": "combineBySql",
        "query": "SELECT\n  i1.id,\n  i1.name,\n  i1.person_name,\n  i1.`partner_id[0]`    AS partner_id,\n  i1.`partner_id[1]`    AS partner_name,\n  i1.`priority[0]`      AS priority_value,\n  i1.`priority[1]`      AS priority_label,\n  i1.state,\n  i1.`stage_id[0]`      AS stage_id,\n  i1.`stage_id[1]`      AS stage_name,\n  i1.`ticket_type[0]`   AS ticket_type_id,\n  i1.`ticket_type[1]`   AS ticket_type_label,\n  i1.tag_ids,\n  json_group_array(DISTINCT t.name) AS tag_names,\n  i1.`subject_id[0]`    AS subject_id,\n  i1.`subject_id[1]`    AS subject_name,\n  i1.email,\n  i1.description,\n  i1.customer_comment,\n  i1.comment,\n  i1.color,\n  i1.message_partner_ids,\n  i1.message_ids,\n  i1.invoice_count,\n  i1.`user_id[0]`       AS user_id,\n  i1.`user_id[1]`       AS user_name\nFROM input1 AS i1\n\nLEFT JOIN json_each(i1.tag_ids) AS j\nLEFT JOIN input2 AS t\n  ON CAST(t.id AS INTEGER) = CAST(j.value AS INTEGER)\nGROUP BY\n  i1.id, i1.name, i1.person_name,\n  i1.`partner_id[0]`, i1.`partner_id[1]`,\n  i1.`priority[0]`, i1.`priority[1]`,\n  i1.state, i1.`stage_id[0]`, i1.`stage_id[1]`,\n  i1.`ticket_type[0]`, i1.`ticket_type[1]`,\n  i1.tag_ids,\n  i1.`subject_id[0]`, i1.`subject_id[1]`,\n  i1.email, i1.description, i1.customer_comment, i1.comment, i1.color,\n  i1.message_partner_ids, i1.message_ids, i1.invoice_count,\n  i1.`user_id[0]`, i1.`user_id[1]`\nORDER BY i1.id;\n",
        "options": {}
      },
