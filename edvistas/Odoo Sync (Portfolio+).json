  "createdAt": "2023-09-28T20:36:08.907Z",
  "id": "KPAFMED211O9xFjm",
  "name": "Odoo Sync (Portfolio+)",
  "nodes": [
    {
      "parameters": {
        "content": "# Sync Odoo Tags with Edge Doc Customers\n### This node will update Odoo Contacts that have a EVI District number present in the 'EVI_DistID' field.\n##### Tags contain product names that a specific district have activated in [EVICore](https://apps.edvistas.com). This workflow query [EVICore](https://apps.edvistas.com)for the most up to date list of Products by District. All contacts in Odoo with a value in the 'EVI_DistID' field will be used in this dataset.\n\n**This is a **Sync** operation so it will add and remove remove tags from odoo that match [EVICore](https://apps.edvistas.com).\n",
        "height": 610.9027580150877,
        "width": 1221.561785145882
      },
      "id": "c2d5d5f8-4df5-4195-b20b-ef9c0e4f6339",
      "name": "Sticky Note3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        684,
        -564
      ]
    },
    {
      "parameters": {
        "resource": "custom",
        "customResource": "res.partner",
        "operation": "getAll",
        "returnAll": true,
        "options": {
          "fieldsList": [
            "name",
            "EVI_DistID",
            "category_id",
            "EVI_License"
          ]
        },
        "filterRequest": {
          "filter": [
            {
              "fieldName": "EVI_DistID",
              "operator": "notEqual"
            }
          ]
        }
      },
      "id": "39ef90b5-146d-4163-b5ff-356c51495b99",
      "name": "Get Contacts",
      "type": "n8n-nodes-base.odoo",
      "typeVersion": 1,
      "position": [
        780,
        -320
      ],
      "credentials": {
        "odooApi": {
          "id": "12",
          "name": "Odoo (Administrator)"
        }
      }
    },
    {
      "parameters": {
        "resource": "custom",
        "customResource": "res.partner",
        "operation": "update",
        "customResourceId": "={{ $json.id }}",
        "fieldsToCreateOrUpdate": {
          "fields": [
            {
              "fieldName": "category_id",
              "fieldValue": "={{ $json.appended_tagId }}"
            },
            {
              "fieldName": "EVI_License",
              "fieldValue": "={{ $json.concatenated_Product.replace(/(District|Business), /g, ''); }}"
            }
          ]
        }
      },
      "id": "495170fa-4a7a-4a85-a84c-89ba2f497539",
      "name": "Update Odoo Tags",
      "type": "n8n-nodes-base.odoo",
      "typeVersion": 1,
      "position": [
        1700,
        -300
      ],
      "credentials": {
        "odooApi": {
          "id": "12",
          "name": "Odoo (Administrator)"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "mergeByFields": {
          "values": [
            {
              "field1": "EVI_DistID",
              "field2": "EVI_DIST_ID"
            }
          ]
        },
        "options": {
          "fuzzyCompare": true
        }
      },
      "id": "a43ae69e-2840-431c-a1fb-1ae8ba09f6f1",
      "name": "Matching",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        1300,
        -300
      ]
    },
    {
      "parameters": {
        "operation": "summarize",
        "fieldsToSummarize": {
          "values": [
            {
              "aggregation": "concatenate",
              "field": "Product",
              "includeEmpty": true,
              "separateBy": ", "
            },
            {
              "aggregation": "append",
              "field": "tagId",
              "includeEmpty": true
            }
          ]
        },
        "fieldsToSplitBy": "EVI_DIST_ID",
        "options": {}
      },
      "id": "5b831fa2-aa52-4fbd-b2c6-b1b77fa8dbc0",
