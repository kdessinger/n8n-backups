    {
      "parameters": {
        "jsCode": "// 1. Pull data specifically from the 'Upload Website Screenshot' node\nconst screenshots = $('Upload Website Screenshot').all();\n\nreturn screenshots.map(item => {\n  // 2. Get the URL safely from the item\n  const url = item.json.url;\n\n  // 3. Safety Check: If url is missing, return item as is (prevents the crash)\n  if (!url) return item;\n\n  // 4. Extract the filename (removes https://.../)\n  const filename = url.split('/').pop();\n\n  // 5. Remove the extension (removes .png, .jpg, etc)\n  // We use lastIndexOf to ensure we don't accidentally cut off parts of the ID if it has dots\n  const pathId = filename.substring(0, filename.lastIndexOf('.'));\n\n  // 6. Save result\n  item.json.path_id = pathId;\n\n  return item;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
