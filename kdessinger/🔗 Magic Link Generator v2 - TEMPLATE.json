      "name": "Sticky Note"
    },
    {
      "parameters": {
        "jsCode": "// Get the input data\nconst items = $input.all();\n\n// Initialize variables\nlet magicLinkId = null;\nlet demoContextId = null;\n\n// Loop through the input\nfor (const item of items) {\n  \n  // Access the 'fields' array\n  const allFields = item.json.fields || [];\n\n  // 1. Find Magic Link ID\n  const magicLinkField = allFields.find(field => field.fieldKey === 'contact.magic_link');\n  if (magicLinkField) {\n    magicLinkId = magicLinkField.id;\n  }\n\n  // 2. Find Demo Context ID\n  const demoContextField = allFields.find(field => field.fieldKey === 'contact.demo_context');\n  if (demoContextField) {\n    demoContextId = demoContextField.id;\n  }\n}\n\n// Return both IDs in a single object\nreturn {\n  json: {\n    magic_link_id: magicLinkId || \"NOT_FOUND\",\n    demo_context_id: demoContextId || \"NOT_FOUND\"\n  }\n};"
      },
